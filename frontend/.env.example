# TMDB API Key — server-only (no NEXT_PUBLIC prefix, never exposed to the client)
TMDB_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
